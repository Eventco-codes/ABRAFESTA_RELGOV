# Endpoint da API do Appwrite (self-hosted). Ex: https://appwrite.suaempresa.com.br/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=

# Project ID criado no Console do Appwrite
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# API Key do projeto (Project > Overview > Integrate > API Keys), escopos:
# databases.read, databases.write, users.read, users.write, functions.read, functions.write
# NUNCA prefixar com NEXT_PUBLIC_ — só usada no servidor.
APPWRITE_API_KEY=

# Database ID usado pelo app e pelos scripts (criado por scripts/setup-appwrite.mjs)
APPWRITE_DATABASE_ID=relgov

# URL pública do app (usada no e-mail semanal e no link do CTA). Em dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Módulo de sincronização SIORG (estrutura organizacional do governo federal) —
# ver scripts/setup-siorg-tables.mjs e app/api/siorg/sync/route.ts
SIORG_BASE_URL=https://estruturaorganizacional.dados.gov.br/doc
SIORG_SYNC_SECRET=
SIORG_PODERES=1
SIORG_ESFERAS=1

# Módulo de sincronização Senado (processos em tramitação + senadores) —
# ver scripts/setup-senado-tables.mjs e app/api/senado/sync/route.ts
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
SENADO_SYNC_SECRET=
SENADO_SIGLAS=PL,PLP,PEC,MPV,PDL
SENADO_ANOS=2025,2026
SENADO_TERMOS=

# Geração agendada do relatório em PDF (cron) — ver app/api/relatorios/pdf/pre-gerar/route.ts.
# Mínimo de 16 caracteres. Gere com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Header da chamada:  x-pdf-cron-secret: $PDF_CRON_SECRET
PDF_CRON_SECRET=

# Varredura semanal automática (cron, segunda 06:00) — ver app/api/monitoramento/semanal/route.ts.
# Mínimo de 16 caracteres (mesmo comando acima para gerar).
# Header da chamada:  x-monitoramento-secret: $MONITORAMENTO_CRON_SECRET
MONITORAMENTO_CRON_SECRET=
